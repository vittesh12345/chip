        514: begin rtl.u_thermal.u_copy1.q[0] = ~rtl.u_thermal.u_copy1.q[0]; gl.\u_thermal.u_copy1/q[0]$_SDFFE_PN0P_ .IQ = ~gl.\u_thermal.u_copy1/q[0]$_SDFFE_PN0P_ .IQ; end
        515: begin rtl.u_thermal.u_copy1.q[1] = ~rtl.u_thermal.u_copy1.q[1]; gl.\u_thermal.u_copy1/q[1]$_SDFFE_PN1P_ .IQ = ~gl.\u_thermal.u_copy1/q[1]$_SDFFE_PN1P_ .IQ; end
        516: begin rtl.u_thermal.u_copy2.q[0] = ~rtl.u_thermal.u_copy2.q[0]; gl.\u_thermal.u_copy2/q[0]$_SDFFE_PN0P_ .IQ = ~gl.\u_thermal.u_copy2/q[0]$_SDFFE_PN0P_ .IQ; end
        517: begin rtl.u_thermal.u_copy2.q[1] = ~rtl.u_thermal.u_copy2.q[1]; gl.\u_thermal.u_copy2/q[1]$_SDFFE_PN1P_ .IQ = ~gl.\u_thermal.u_copy2/q[1]$_SDFFE_PN1P_ .IQ; end
        default: begin $display("flip_copy: bad index %0d", k); $finish; end
        endcase
    end
endtask

// 0: duplicated accumulator/result copy, 1: thermal TMR copy.
function integer flip_kind(input integer k);
    flip_kind = (k >= 512) ? 1 : 0;
endfunction

