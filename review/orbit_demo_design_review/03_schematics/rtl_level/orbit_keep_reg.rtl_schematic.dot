n2 [ shape=octagon, label="d", color="black", fontcolor="black"];
n3 [ shape=octagon, label="en", color="black", fontcolor="black"];
n4 [ shape=octagon, label="rst_n", color="black", fontcolor="black"];
n5 [ shape=octagon, label="clk", color="black", fontcolor="black"];
{ rank="source"; n2; n3; n4; n5;}
{ rank="sink"; n1;}
c11 [ shape=record, label="{{<p6> CLK|<p7> D|<p8> EN|<p9> SRST}|$72\n$sdffe|{<p10> Q}}",  ];
c11:p10:e -> n1:w [colorscheme="dark28", color="5", fontcolor="5", style="setlinewidth(3)", label="<32>"];
